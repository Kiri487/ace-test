# =============================================================================
# Provider API keys (just fill in the ones you need)
# =============================================================================
# OpenAI API Key
# Get your API key from: https://openai.com/api/
OPENAI_API_KEY=your_openai_api_key

# Cline API key (use with --api_provider clinepass)
# Create a key at https://app.cline.bot -> Settings -> API Keys
#
# THE PREFIX DECIDES WHO PAYS. api.cline.bot fronts two separate providers:
#   cline-pass/...  -> the flat $9.99/mo ClinePass subscription
#   deepseek/... etc -> Cline (usage-billing), pay-as-you-go credits
# Both answer on the same endpoint with the same key, and a non-Pass slug is
# billed to credits silently - no warning, no error. Always use cline-pass/.
# GET /models does NOT list the cline-pass/* ids; the docs are the source of
# truth for them, not the catalogue.
#
#   cline-pass/deepseek-v4-flash    cline-pass/deepseek-v4-pro
#   cline-pass/qwen3.8-max          cline-pass/glm-5.3    (13 models total)
#
# Quota is a 5-hour rolling window + weekly + monthly, measured against the
# reference per-token prices in the docs. Check the Cline dashboard for usage.
CLINE_API_KEY=your_cline_api_key
# Optional: override the endpoint (defaults to https://api.cline.bot/api/v1)
# CLINE_BASE_URL=

# Groq API Key (OpenAI-compatible; use with --api_provider groq)
# NOTE: superseded by clinepass for ACE runs. Groq's free tier caps at
# 200K tokens/day, which is only ~44 ACE calls/day - not enough for a run.
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
# Optional: override the endpoint (defaults to https://api.groq.com/openai/v1)
# GROQ_BASE_URL=

# Google Gemini API Key (OpenAI-compatible; use with --api_provider gemini)
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Optional: override the endpoint
# (defaults to https://generativelanguage.googleapis.com/v1beta/openai/)
# GEMINI_BASE_URL=

# Local Ollama server (OpenAI-compatible; use with --api_provider ollama)
# Needs no key. Optional: override the endpoint
# (defaults to http://localhost:11434/v1)
# OLLAMA_BASE_URL=

# SambaNova API Keys
# Get your API keys from: https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=your_sambanova_api_key

# Together API Key
# Get your API key from: https://together.ai/
TOGETHER_API_KEY=your_together_api_key

# Commonstack API Key
# Get your API key from: https://commonstack.ai/
COMMONSTACK_API_KEY=your_commonstack_api_key
