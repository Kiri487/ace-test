# =============================================================================
# Provider API keys (just fill in the ones you need)
# =============================================================================
# OpenAI API Key
# Get your API key from: https://openai.com/api/
OPENAI_API_KEY=your_openai_api_key

# Optional: point the "openai" provider at an OpenAI-compatible endpoint instead
# of https://api.openai.com/v1. OPENAI_API_KEY is then the key for that service.
# Leave unset to use the official OpenAI API. Examples:
#   Groq          OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   Google Gemini OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama        OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_BASE_URL=

# Groq API Key (OpenAI-compatible; use with --api_provider groq)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
# Optional: override the endpoint (defaults to https://api.groq.com/openai/v1)
# GROQ_BASE_URL=

# Google Gemini API Key (OpenAI-compatible; use with --api_provider gemini)
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Optional: override the endpoint
# (defaults to https://generativelanguage.googleapis.com/v1beta/openai/)
# GEMINI_BASE_URL=

# SambaNova API Keys
# Get your API keys from: https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=your_sambanova_api_key

# Together API Key
# Get your API key from: https://together.ai/
TOGETHER_API_KEY=your_together_api_key

# Commonstack API Key
# Get your API key from: https://commonstack.ai/
COMMONSTACK_API_KEY=your_commonstack_api_key
